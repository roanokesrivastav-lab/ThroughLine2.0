# ---- Client-safe (the ONLY values that may reach the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public half of the VAPID pair used for Web Push (optional; push is disabled without it)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- Server-only (never exposed to the client) ----
# Service role key: used only in server code for the shared media catalog and cron jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic. Leave ANTHROPIC_API_KEY empty to use the deterministic mock extraction/explanation layer.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5). A cheaper model lowers extraction cost.
ANTHROPIC_MODEL=
# NVIDIA NIM (server-only). Set AI_PROVIDER=nvidia to use it; default model is nvidia/nemotron-3-super-120b-a12b (gpt-oss-20b tested inconsistent).
AI_PROVIDER=mock
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Metadata providers. TMDB needs a key; Open Library and MusicBrainz do not.
# Without TMDB_API_KEY, movie/TV/anime search falls back to the built-in canon list.
TMDB_API_KEY=
# MusicBrainz requires an identifying User-Agent with contact info.
MUSICBRAINZ_USER_AGENT=Throughline/0.1 (you@example.com)

# Web Push private half (generate both with: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/daily. Vercel Cron sends it as a Bearer token automatically when set.
CRON_SECRET=change-me

# Optional: used by the CLI demo seeder (scripts/seed-demo.ts) to create/sign in the demo account
DEMO_EMAIL=demo@throughline.local
DEMO_PASSWORD=throughline-demo
